// Prisma 7: the datasource URL lives in prisma.config.ts, not in `env()` here.
// The `prisma-client` generator requires an explicit output path.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Analytics session — one per browser tab visit (sessionStorage-scoped).
model Session {
  id            String   @id @default(cuid())
  /// Human-friendly sequential id shown in the admin as "#1042".
  /// Postgres autoincrement requires the column to be indexed, hence @unique.
  visitorNumber Int      @unique @default(autoincrement())
  arrivedAt     DateTime @default(now())
  device        String
  /// Browser family (Chrome, Safari, …) derived server-side from the UA header.
  browser       String?
  /// Raw User-Agent. Meta's Conversions API matches on client_user_agent
  /// paired with client_ip_address, so the family name alone is not enough.
  userAgent     String?
  isReturning   Boolean  @default(false)
  ip            String?
  location      String?
  /// Derived, human-readable attribution shown in the sessions table. Falls
  /// back to referrer host / click-id inference when no UTM tags are present.
  source        String?
  medium        String?
  campaign      String?

  /// --- Acquisition: captured verbatim from the landing URL, once per session.
  /// `source`/`medium`/`campaign` above are the *derived* view; these are the
  /// raw tags, kept separate so a derivation change never rewrites history.
  entryPath      String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  /// Ad-platform click ids: Google, Meta, Microsoft.
  gclid          String?
  fbclid         String?
  msclkid        String?
  /// Meta's own browser cookies, read from the request when an enquiry is
  /// submitted (the Pixel writes them, so they only exist once it has loaded).
  /// `_fbc` is preferred over the fbclid-derived value because it carries the
  /// real click timestamp; `_fbp` has no other source at all. Both go to the
  /// Conversions API unhashed and are the single biggest lever on match quality.
  fbp            String?
  fbc            String?
  /// Meta ad hierarchy, populated from Meta's dynamic URL parameters
  /// ({{campaign.id}}, {{adset.id}}, {{ad.id}}, {{placement}}).
  placement      String?
  metaCampaignId String?
  metaAdsetId    String?
  metaAdId       String?
  /// Every query param on the landing URL, verbatim. The catch-all: a new ad
  /// platform or a custom param is never lost just because it has no column.
  /// Null (not `{}`) for direct traffic, so empty rows cost nothing.
  rawParams      Json?

  /// --- Environment. Captured once at session start, straight from the
  /// browser: what this visitor actually browses on. `device` and `browser`
  /// above are the coarse buckets the tables group by; these are the detail
  /// the Tech Stack page reads. All nullable — an older cached tracker.js
  /// keeps posting sessions without them.
  os             String?
  browserVersion String?
  screenWidth    Int?
  screenHeight   Int?
  viewportWidth  Int?
  viewportHeight Int?
  language       String?
  timezone       String?
  /// Network Information API `effectiveType` (4g/3g/2g/slow-2g). Chrome-only —
  /// Safari and Firefox do not implement it, so expect this to be mostly null.
  connection     String?

  durationSec   Int?
  bounced       Boolean  @default(false)
  /// Max scroll percentage reached, 0-100.
  scrollDepth   Int      @default(0)
  formFilled    Boolean  @default(false)
  replayUrl     String?

  /// Client-generated id from sessionStorage. The tracker knows this before the
  /// row exists, so it is the lookup key for every subsequent beacon.
  clientId      String   @unique
  /// Stable localStorage id across sessions — what makes isReturning meaningful.
  visitorId     String?
  lastSeenAt    DateTime @default(now())
  /// Counted server-side; a session with >1 interaction has not bounced.
  eventCount    Int      @default(0)

  events        PageEvent[]
  lead          Lead?
  replayChunks  ReplayChunk[]
  ctaEvents     CtaEvent[]
  formEvents    FormEvent[]
  mouseSignals  MouseInteraction[]
  metrics       PerformanceMetric[]
  errors        ErrorEvent[]

  @@index([arrivedAt])
  @@index([visitorId])
  /// Covers the common "sessions from campaign X" grouping in the admin.
  @@index([utmSource, utmMedium, utmCampaign])
  /// Looked up on its own when joining against ad-platform spend by campaign id.
  @@index([metaCampaignId])
}

/// Enquire Now form submission.
model Lead {
  id            String   @id @default(cuid())
  sessionId     String?  @unique
  session       Session? @relation(fields: [sessionId], references: [id])
  name          String
  phone         String
  email         String?
  budgetRange   String?
  configuration String?
  /// Free-text note. Only ever collected on the thank-you page.
  message       String?
  submittedAt   DateTime @default(now())
  /// Sales pipeline stage: new | contacted | qualified | won | lost.
  /// A String, not an enum: the stages are a sales convention that will change
  /// without a migration, and the app validates them on write.
  status        String   @default("new")
  /// When the stage last changed, so "sitting in new for 3 days" is visible.
  statusAt      DateTime?
  /// Set when the visitor adds optional details on the thank-you page, so the
  /// sales team can tell an enriched lead from a bare name + phone.
  enrichedAt    DateTime?
  /// Full raw payload, kept as an audit trail if the form ever gains fields.
  raw           Json?

  /// --- Meta Conversions API.
  /// Written by BOTH the automatic send on lead creation and the manual send
  /// from the admin, so the Sent/Failed badge reflects whichever fired last.
  metaCapiSentAt    DateTime?
  metaCapiError     String?
  /// The event name last delivered ("Lead", "Purchase", a custom name…).
  metaCapiEventName String?
  /// Shared with the browser Pixel's event_id so Meta deduplicates the two
  /// deliveries of the same conversion instead of counting it twice.
  metaEventId       String?

  @@index([submittedAt])
  @@index([status])
}

/// Individual interaction beacon. Click/hover rows carry the heatmap coordinates.
model PageEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  /// Normalised 0-1 position within the full page, so the heatmap is
  /// viewport-width independent.
  xPct      Float?
  yPct      Float?
  path      String?
  timestamp DateTime @default(now())

  @@index([type])
  @@index([sessionId])
}

/// A call-to-action impression, hover or click.
///
/// Keyed by the `data-cta-id` attribute in the markup, which is the whole
/// convention: tagging a new button `data-cta-id="hero-call"` tracks it with
/// no JavaScript change at all.
model CtaEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ctaId     String
  /// viewed | hover | click
  type      String
  /// Visible text at the time of the event — so a renamed button is still
  /// recognisable in the admin months later.
  label     String?
  path      String?
  timestamp DateTime @default(now())

  /// The CTAs table groups by id and type together.
  @@index([ctaId, type])
  @@index([sessionId])
}

/// A step in a form's lifecycle, keyed by `data-form-id`.
///
/// The funnel between these types is the point: viewed → started → submitted
/// says where enquiries are lost, which a submission count alone cannot.
model FormEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  formId    String
  /// viewed | started | field_focus | field_complete | validation_error |
  /// abandoned | submitted
  type      String
  /// Which input, for the field-level types. Names only — never values.
  field     String?
  path      String?
  timestamp DateTime @default(now())

  @@index([formId, type])
  @@index([sessionId])
}

/// Frustration signals, derived client-side from click patterns.
///
/// Deliberately not called MouseEvent: that is a DOM lib type, and a Prisma
/// model of the same name would shadow it in every file that imports the
/// generated client.
model MouseInteraction {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// rage_click | dead_click | double_click
  type      String
  /// CSS selector of the element hit, so hotspots can be ranked by element.
  selector  String?
  /// Its visible text, truncated — a selector alone is hard to place on a page.
  label     String?
  path      String?
  timestamp DateTime @default(now())

  @@index([type])
  @@index([sessionId])
}

/// One Core Web Vital sample. Rated with Google's own thresholds at capture
/// time so the admin never has to re-derive them.
model PerformanceMetric {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// LCP | INP | CLS | FCP | TTFB
  name      String
  /// Milliseconds for every metric except CLS, which is unitless.
  value     Float
  /// good | needs-improvement | poor
  rating    String
  path      String?
  timestamp DateTime @default(now())

  @@index([name, rating])
  @@index([sessionId])
}

/// A client-side error: thrown exception, unhandled rejection, or an <img>
/// that failed to load. What makes "it works on my machine" checkable.
model ErrorEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// js | promise | resource
  kind      String
  message   String
  /// File or asset URL, and the line within it when the browser reports one.
  source    String?
  line      Int?
  path      String?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([sessionId])
}

/// A batch of rrweb DOM-recording events for full session replay. One row per
/// flushed batch; the player concatenates them in `seq` order to reconstruct
/// the visit. Stored as chunks because rrweb emits far too many events to keep
/// one row each.
model ReplayChunk {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Monotonic per-session index, assigned client-side, for stable ordering.
  seq       Int
  /// Array of rrweb events exactly as emitted on the client.
  events    Json
  createdAt DateTime @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId])
}

/// Admin panel login. Seeded from env vars — see prisma/seed.ts.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
