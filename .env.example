# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
# DATABASE_URL — the POOLED connection string. Used by the running app.
#   Host contains "-pooler". Keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL — the DIRECT (non-pooled) connection string. Used only by
#   `prisma migrate` / `prisma db seed`, which need advisory locks that the
#   pooler cannot provide. Same host without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Admin auth
# ---------------------------------------------------------------------------
# Encrypts the admin session cookie. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# The single admin login, applied by `npx prisma db seed`.
# Re-running the seed updates the password.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Meta Conversions API
# ---------------------------------------------------------------------------
# Your Meta Pixel / dataset ID.
META_PIXEL_ID="1330281962604710"

# Events Manager → Data Sources → your pixel → Settings → Generate access token.
# Without this, sends fail in production and fall back to a UI-only preview in
# development.
META_CAPI_ACCESS_TOKEN=""

# Optional. Events Manager → Test Events tab shows a code like TEST12345.
# While set, events go to Test Events instead of live reporting — leave EMPTY
# in production or your real conversions will not be counted.
META_TEST_EVENT_CODE=""

# Optional. Graph API version; v26.0 is the current ceiling.
# META_GRAPH_API_VERSION="v26.0"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The origin the heatmap loads in its preview iframe. Leave as the deployed
# landing page URL; same-origin lets the overlay measure the real page height.
NEXT_PUBLIC_SITE_URL="https://tata-realty.vercel.app"
